{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gops.local/model-contract.schema.json",
  "title": "GOPS browser model manifest",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "observationSize", "actionSize", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "observationSize": { "const": 56 },
    "actionSize": { "const": 13 },
    "models": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["difficulty", "file", "sha256", "modelVersion", "trainingRun", "observationVersion", "metrics"],
        "properties": {
          "difficulty": { "enum": ["beginner", "casual", "skilled", "expert"] },
          "file": { "type": "string", "pattern": "\\.onnx$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "observationVersion": { "const": 1 }
        }
      }
    }
  }
}

